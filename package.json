{
  "name": "leave-sprint-twin",
  "version": "0.1.0",
  "private": true,
  "description": "Monorepo: Waypoint (career hub). Local-first.",
  "packageManager": "pnpm@11.10.0",
  "scripts": {
    "dev": "pnpm --filter waypoint dev",
    "build": "pnpm --filter waypoint build",
    "start": "pnpm --filter waypoint start",
    "db:migrate": "pnpm --filter waypoint db:migrate",
    "lint": "oxlint apps/waypoint packages",
    "lint:fix": "oxlint apps/waypoint packages --fix",
    "typecheck": "pnpm typecheck:waypoint && pnpm typecheck:packages",
    "typecheck:waypoint": "tsc --noEmit -p apps/waypoint/tsconfig.json",
    "typecheck:packages": "tsc --noEmit -p packages/rubric/tsconfig.json && tsc --noEmit -p packages/qbank/tsconfig.json && tsc --noEmit -p packages/practice-types/tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "@types/node": "^22",
    "@types/react": "^19.2",
    "@types/react-dom": "^19.2",
    "clsx": "^2.1.1",
    "oxlint": "^1.73.0",
    "postcss": "^8.5",
    "tailwind-merge": "^3.2.0",
    "tailwindcss": "^4.1",
    "typescript": "^6.0.3",
    "vitest": "^4.1.10"
  }
}
