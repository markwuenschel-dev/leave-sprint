# Copy to .env (repo root) for local dev — this single file is the source of truth.
# apps/waypoint loads it via next.config.ts (Next otherwise only reads app-folder
# env files). .env is gitignored.
#
# Every key below is READ by live code; the file:line next to each is the reader.
# Everything is commented out on purpose: an uncommented line changes behaviour
# for anyone who copies this file, so nothing here turns a feature on by default.
# Uncomment only what you need.
#
# NOTE: there is no required key. Waypoint boots with an empty .env — embedded
# database, open access gate, no LLM providers available.


# =============================================================================
# Database — OPTIONAL
# =============================================================================
# Directory holding the embedded PGlite database (apps/waypoint/lib/db/index.ts:19-21).
# UNSET → `<process.cwd()>/.pglite`, which means the SAME command started from a
# different working directory reads and writes a DIFFERENT database. Set an
# absolute path if you ever start the app from anywhere but the app folder.
# WAYPOINT_PGLITE_DIR=/absolute/path/to/.pglite
#
# There is no DATABASE_URL / remote Postgres in Waypoint — PGlite only
# (apps/waypoint/lib/db/index.ts:1-2). DATABASE_URL is read solely by the frozen
# predecessor app at the repo root, not by anything under apps/waypoint.


# =============================================================================
# Access gate — OPTIONAL
# =============================================================================
# Shared token gating the whole site (apps/waypoint/proxy.ts:14,
# apps/waypoint/app/api/unlock/route.ts:26).
# UNSET → the gate is disabled and the app is fully open (fine locally; set a
# strong value in production). Unlock by visiting `?token=<value>` once.
# APP_TOKEN=change-me
#
# NODE_ENV is set by Next/Node, not by you. "production" makes the access cookie
# Secure (apps/waypoint/lib/auth/token.ts:35); "test" forces hermetic mode
# (apps/waypoint/lib/llm/hermetic.ts:73).


# =============================================================================
# LLM — preferred path: local LiteLLM gateway (see litellm-langfuse-gateway repo)
# =============================================================================
# When LITELLM_VIRTUAL_KEY is set AND starts with sk-, all four AI Interviewer
# providers route through the gateway and you need no direct provider keys
# (apps/waypoint/lib/llm/registry.ts:29-31,57-66). The gateway must be running
# (Docker). Restart `pnpm dev` after changing any of these.
#
# UNSET → gateway off; each provider falls back to its own key below.
# Create one with: uv run llg keys create \
#   --models llm-general,openai-general,anthropic-general,gemini-general,grok-general \
#   --max-budget 50 --rpm 120 --key-alias leave-sprint-dev
# LITELLM_VIRTUAL_KEY=sk-...
#
# Gateway base URL (apps/waypoint/lib/llm/registry.ts:33-36).
# UNSET → http://localhost:4000/v1
# LITELLM_BASE_URL=http://localhost:4000/v1
#
# Force ONE gateway model alias for every provider (apps/waypoint/lib/llm/registry.ts:60).
# UNSET → the per-provider alias (openai-general, grok-general, …).
# LITELLM_MODEL=llm-general


# =============================================================================
# Direct provider keys — OPTIONAL (legacy / fallback when the gateway is off)
# =============================================================================
# A provider is "available" iff its key is set OR LITELLM_VIRTUAL_KEY is set
# (apps/waypoint/lib/llm/registry.ts:39-42). Selecting a provider whose key is
# missing throws at apps/waypoint/lib/llm/registry.ts:70.
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# XAI_API_KEY=
# GEMINI_API_KEY=
#
# Dictation (voice) always uses OpenAI Whisper directly and needs OPENAI_API_KEY
# even when the gateway is on (apps/waypoint/lib/llm/transcribe.ts:31-32);
# UNSET → dictation is unavailable and the API returns OpenAIUnavailableError.
#
# GOOGLE_API_KEY is never read by our code, but the @google/genai SDK picks it up
# implicitly, so it is on the cost-kill list (apps/waypoint/lib/llm/hermetic.ts:29)
# and gets blanked under hermetic mode like every other billable key.
# GOOGLE_API_KEY=


# =============================================================================
# Hermetic mode / cost kill — OPTIONAL
# =============================================================================
# Refuses every live LLM call and blanks all billable keys in-process
# (apps/waypoint/lib/llm/hermetic.ts:68-75, apps/waypoint/next.config.ts).
# It is ON automatically under vitest (VITEST set by the runner) and when
# NODE_ENV=test, so a developer .env can never bill CI.
# UNSET → live calls allowed in normal `next dev`.
# LLG_HERMETIC=1
#
# The only escape hatch: =1 re-enables live, billable calls even under test
# (apps/waypoint/lib/llm/hermetic.ts:69, apps/waypoint/lib/llm/registry.ts:51).
# Set it for intentional paid runs ONLY.
# LLG_ALLOW_LIVE=1


# =============================================================================
# Gateway call attribution (Langfuse) — OPTIONAL, gateway path only
# =============================================================================
# These tag traffic sent THROUGH the LiteLLM gateway
# (apps/waypoint/lib/llm/adapters/openai.ts:16-33,118-131). Direct OpenAI/Grok
# calls never carry them. Empty and whitespace-only values count as UNSET.
#
# Service name in Langfuse. UNSET → "leave-sprint".
# SERVICE_NAME=leave-sprint
# LLG_SERVICE=            # fallback for SERVICE_NAME
#
# Environment tag. UNSET → "development".
# ENVIRONMENT=development
# LLG_ENVIRONMENT=        # fallback for ENVIRONMENT
#
# Release/version tag, first non-empty of GIT_SHA, RELEASE, LLG_RELEASE.
# All UNSET → "dev".
# GIT_SHA=
# RELEASE=
# LLG_RELEASE=


# =============================================================================
# Deploy scripts (scripts/deploy.sh, scripts/deploy.ps1) — shell env, not .env
# =============================================================================
# These are read by the deploy scripts from your shell, NOT loaded from this
# file. Listed so the full set is documented in one place.
#   SSH_KEY  deploy key path             UNSET → $HOME/.ssh/shared-box.pem
#   BOX      deploy target host          UNSET → ubuntu@44.198.76.44
#   URL      post-deploy health-check URL UNSET → https://leavesprint.44-198-76-44.nip.io
#   TAIL     container log lines to tail  UNSET → 40
#   DRY_RUN  print the remote script instead of running it (any non-empty value)
